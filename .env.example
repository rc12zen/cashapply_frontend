# cashapply_frontend — environment template
#
# Copy to .env.local (local dev) or .env.uat (UAT build). Both are gitignored;
# this template is not, so keep real keys out of it.
#
# IMPORTANT: every NEXT_PUBLIC_* value is inlined into the client bundle at
# BUILD time. Changing one means rebuilding the frontend, not just restarting
# it — and it also means none of these can hold a genuine secret, since
# anything here is readable by anyone who loads the app.

# ── Backend API ──────────────────────────────────────────────────────────────
# No sensible default other than localhost, so this must be set for UAT/prod.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── API payload encryption (VAPT remediation) ────────────────────────────────
# This MUST match the backend's API_ENCRYPTION_KEY for the same environment.
# The value below is the sample from backend.env.local.example -- the two files
# are a matched pair, so copy both or neither.
#
# It used to say "leave blank for local", because the backend defaulted
# encryption OFF when APP_ENV=local. That is no longer true: the backend now
# encrypts in every environment unless API_ENCRYPTION_ENABLED=false. Leaving
# this blank against an encrypting backend means responses arrive sealed and
# nothing can read them.
#
# Next inlines this at BUILD time, so changing it needs a REBUILD, not just a
# restart. If responses stop parsing after a key change, that is usually why.
#
# For UAT/prod, mint a FRESH key per environment on the backend side and copy
# it here -- do not reuse the sample, which is in version control:
#
#     cd ../cashapply_backend && python -m scripts.gen_api_key
#
# Presence of a key is the ONLY switch: set it and the frontend encrypts, leave
# it blank and it does not. There is deliberately no second on/off flag that
# could disagree with it, and no key-id either -- each payload carries a
# fingerprint derived from the key, so both sides agree without a shared label.
# To run plaintext end-to-end, blank this AND set API_ENCRYPTION_ENABLED=false
# on the backend; changing only one side breaks every request.
NEXT_PUBLIC_API_ENCRYPTION_KEY=Na1tN+JNupIZeVM/cYOGK/UGbt2OlR0XhkxvhFgvlGc=

# ── Deployment tier ──────────────────────────────────────────────────────────
# Mirrors the backend's APP_ENV. Drives IS_LOCAL_DEV in lib/msalConfig.ts,
# which selects the X-Dev-User cookie bypass over real MSAL token acquisition.
NEXT_PUBLIC_APP_ENV=local

# ── Azure AD SSO (UAT/prod) ──────────────────────────────────────────────────
# Local dev uses the X-Dev-User cookie bypass instead; see lib/msalConfig.ts
# and the backend's app/auth/bypass.py.
# NEXT_PUBLIC_AZURE_TENANT_ID=
# NEXT_PUBLIC_AZURE_CLIENT_ID=
# NEXT_PUBLIC_AZURE_REDIRECT_URI=
# NEXT_PUBLIC_AZURE_API_SCOPE=
